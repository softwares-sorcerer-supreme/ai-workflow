{
  "openapi": "3.1.1",
  "info": {
    "title": "AiRunner | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Runner health: last poll, poll errors, worker idle or busy.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "tags": [
          "Overview"
        ],
        "summary": "The running job and the queue.",
        "operationId": "getOverview",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Job history, newest first, one page at a time.",
        "operationId": "getJobs",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "One job with its result.",
        "operationId": "getJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/jobs/{id}/files": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "The files in a job's log folder.",
        "operationId": "getJobFiles",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogFilesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/jobs/{id}/files/{name}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "One log file as text (cut after 2 MB).",
        "operationId": "getJobFile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogFileTextResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/issues": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "Every issue the runner polls, with its stage; sub-issues nested unless flat.",
        "operationId": "getIssues",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "component",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stage",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flat",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "lane",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "focus",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/issues/{owner}/{repo}/{number}": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "One issue: stage, what it waits on, analysis summary, sub-issues, PRs and job timeline.",
        "operationId": "getIssue",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/cost": {
      "get": {
        "tags": [
          "Cost"
        ],
        "summary": "Copilot calls, billed credits, tokens, jobs and job time per day, project, issue or model.",
        "operationId": "getCost",
        "parameters": [
          {
            "name": "by",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisSummaryResponse": {
        "required": [
          "status",
          "complexity",
          "component"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CodeLabelResponse"
          },
          "complexity": {
            "$ref": "#/components/schemas/CodeLabelResponse"
          },
          "component": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ApiError": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "CodeLabelResponse": {
        "required": [
          "code",
          "label"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "CostResponse": {
        "required": [
          "by",
          "byLabel",
          "from",
          "to",
          "rows",
          "total",
          "note"
        ],
        "type": "object",
        "properties": {
          "by": {
            "type": "string"
          },
          "byLabel": {
            "type": "string"
          },
          "from": {
            "type": [
              "null",
              "string"
            ]
          },
          "to": {
            "type": [
              "null",
              "string"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CostRowResponse"
            }
          },
          "total": {
            "$ref": "#/components/schemas/CostRowResponse"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CostRowResponse": {
        "required": [
          "key",
          "label",
          "calls",
          "jobs",
          "jobsWithoutCount",
          "durationSeconds",
          "nanoAiu",
          "inputTokens",
          "cacheReadTokens",
          "cacheWriteTokens",
          "outputTokens",
          "jobsWithoutUsage"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "calls": {
            "type": "integer",
            "format": "int32"
          },
          "jobs": {
            "type": "integer",
            "format": "int32"
          },
          "jobsWithoutCount": {
            "type": "integer",
            "format": "int32"
          },
          "durationSeconds": {
            "type": "number",
            "format": "double"
          },
          "nanoAiu": {
            "type": "integer",
            "format": "int64"
          },
          "inputTokens": {
            "type": "integer",
            "format": "int64"
          },
          "cacheReadTokens": {
            "type": "integer",
            "format": "int64"
          },
          "cacheWriteTokens": {
            "type": "integer",
            "format": "int64"
          },
          "outputTokens": {
            "type": "integer",
            "format": "int64"
          },
          "jobsWithoutUsage": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CountResponse": {
        "required": [
          "code",
          "label",
          "count"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "state",
          "stateLabel",
          "runnerName",
          "startedAt",
          "configPath",
          "copilotVersion",
          "pollIntervalSeconds",
          "lastPollStartedAt",
          "lastPollEndedAt",
          "isPolling",
          "worker",
          "errorsLabel",
          "errors"
        ],
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "stateLabel": {
            "type": "string"
          },
          "runnerName": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "configPath": {
            "type": "string"
          },
          "copilotVersion": {
            "type": "string"
          },
          "pollIntervalSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "lastPollStartedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastPollEndedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isPolling": {
            "type": "boolean"
          },
          "worker": {
            "$ref": "#/components/schemas/WorkerHealth"
          },
          "errorsLabel": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PollErrorResponse"
            }
          }
        }
      },
      "IssueDetailResponse": {
        "required": [
          "issue",
          "analysis",
          "subIssues",
          "timeline"
        ],
        "type": "object",
        "properties": {
          "issue": {
            "$ref": "#/components/schemas/IssueRowResponse"
          },
          "analysis": {
            "$ref": "#/components/schemas/AnalysisSummaryResponse"
          },
          "subIssues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueRowResponse"
            }
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobResponse"
            }
          }
        }
      },
      "IssueListResponse": {
        "required": [
          "items",
          "projects",
          "stages",
          "states",
          "sorts",
          "total",
          "lanes",
          "focuses"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueRowResponse"
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectOptionResponse"
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CodeLabelResponse"
            }
          },
          "states": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CodeLabelResponse"
            }
          },
          "sorts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CodeLabelResponse"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "lanes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountResponse"
            }
          },
          "focuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountResponse"
            }
          }
        }
      },
      "IssueRowResponse": {
        "required": [
          "project",
          "repo",
          "number",
          "title",
          "state",
          "stateLabel",
          "stage",
          "stageLabel",
          "lane",
          "flags",
          "badge",
          "waiting",
          "progress",
          "pulls",
          "component",
          "htmlUrl",
          "updatedAt",
          "closedAt",
          "parent",
          "subIssues"
        ],
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "stateLabel": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "stageLabel": {
            "type": "string"
          },
          "lane": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CodeLabelResponse"
            }
          },
          "badge": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CodeLabelResponse"
              }
            ]
          },
          "waiting": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CodeLabelResponse"
              }
            ]
          },
          "progress": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SubIssueCountResponse"
              }
            ]
          },
          "pulls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PullResponse"
            }
          },
          "component": {
            "type": [
              "null",
              "string"
            ]
          },
          "htmlUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "closedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "parent": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "subIssues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueRowResponse"
            }
          }
        }
      },
      "JobResponse": {
        "required": [
          "id",
          "type",
          "typeLabel",
          "status",
          "statusLabel",
          "repo",
          "number",
          "project",
          "createdAt",
          "startedAt",
          "finishedAt",
          "durationSeconds",
          "result",
          "detail",
          "error",
          "hasLog",
          "copilotCalls"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string"
          },
          "typeLabel": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "statusLabel": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "project": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "durationSeconds": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "result": {
            "type": [
              "null",
              "string"
            ]
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "hasLog": {
            "type": "boolean"
          },
          "copilotCalls": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "JobsPageResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LogFileResponse": {
        "required": [
          "name",
          "format",
          "sizeBytes"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
