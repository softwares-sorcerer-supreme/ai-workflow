{
  "openapi": "3.1.1",
  "info": {
    "title": "AiRunner | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Runner health: last poll, poll errors, worker idle or busy.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "tags": [
          "Overview"
        ],
        "summary": "The running job and the queue.",
        "operationId": "getOverview",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Job history, newest first, one page at a time.",
        "operationId": "getJobs",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "One job with its result.",
        "operationId": "getJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/jobs/{id}/files": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "The files in a job's log folder.",
        "operationId": "getJobFiles",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogFilesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/jobs/{id}/files/{name}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "One log file as text (cut after 2 MB).",
        "operationId": "getJobFile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogFileTextResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "state",
          "stateLabel",
          "runnerName",
          "startedAt",
          "configPath",
          "copilotVersion",
          "pollIntervalSeconds",
          "lastPollStartedAt",
          "lastPollEndedAt",
          "isPolling",
          "worker",
          "errorsLabel",
          "errors"
        ],
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "stateLabel": {
            "type": "string"
          },
          "runnerName": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "configPath": {
            "type": "string"
          },
          "copilotVersion": {
            "type": "string"
          },
          "pollIntervalSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "lastPollStartedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastPollEndedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isPolling": {
            "type": "boolean"
          },
          "worker": {
            "$ref": "#/components/schemas/WorkerHealth"
          },
          "errorsLabel": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PollErrorResponse"
            }
          }
        }
      },
      "JobResponse": {
        "required": [
          "id",
          "type",
          "typeLabel",
          "status",
          "statusLabel",
          "repo",
          "number",
          "project",
          "createdAt",
          "startedAt",
          "finishedAt",
          "durationSeconds",
          "result",
          "detail",
          "error",
          "hasLog"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string"
          },
          "typeLabel": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "statusLabel": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "project": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "durationSeconds": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "result": {
            "type": [
              "null",
              "string"
            ]
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "hasLog": {
            "type": "boolean"
          }
        }
      },
      "JobsPageResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LogFileResponse": {
        "required": [
          "name",
          "format",
          "sizeBytes"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LogFilesResponse": {
        "required": [
          "jobId",
          "files"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "integer",
            "format": "int64"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogFileResponse"
            }
          }
        }
      },
      "LogFileTextResponse": {
        "required": [
          "name",
          "format",
          "sizeBytes",
          "text",
          "isTruncated",
          "truncatedNote"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "text": {
            "type": "string"
          },
          "isTruncated": {
            "type": "boolean"
          },
          "truncatedNote": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OverviewResponse": {
        "required": [
          "runningJob",
          "queueLabel",
          "queue"
        ],
        "type": "object",
        "properties": {
          "runningJob": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RunningJobResponse"
              }
            ]
          },
          "queueLabel": {
            "type": "string"
          },
          "queue": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobResponse"
            }
          }
        }
      },
      "PollErrorResponse": {
        "required": [
          "project",
          "message",
          "at"
        ],
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RunningJobResponse": {
        "required": [
          "id",
          "type",
          "typeLabel",
          "repo",
          "number",
          "project",
          "startedAt",
          "elapsedSeconds",
          "round",
          "roundLabel"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string"
          },
          "typeLabel": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "project": {
            "type": [
              "null",
              "string"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "elapsedSeconds": {
            "type": "number",
            "format": "double"
          },
          "round": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "roundLabel": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "WorkerHealth": {
        "required": [
          "state",
          "stateLabel",
          "since"
        ],
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "stateLabel": {
            "type": "string"
          },
          "since": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Overview"
    },
    {
      "name": "Jobs"
    }
  ]
}