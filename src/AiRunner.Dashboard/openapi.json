          "name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "text": {
            "type": "string"
          },
          "isTruncated": {
            "type": "boolean"
